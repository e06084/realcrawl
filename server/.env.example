# RealCrawl 云端域名特征查询服务 - 环境变量配置示例
# 复制此文件为 .env 并根据实际环境修改配置值

# ============================================================================
# 应用配置
# ============================================================================
PROJECT_NAME=RealCrawl 云端域名特征查询服务
API_V1_STR=/api/v1
VERSION=2.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ============================================================================
# 安全配置
# ============================================================================
# 重要：生产环境中必须修改为强密钥
SECRET_KEY=your-secret-key-change-in-production-use-random-64-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# Redis配置 - 特征库缓存集群
# ============================================================================
# Redis集群节点列表，用逗号分隔
REDIS_CLUSTER_NODES=redis://localhost:6379,redis://localhost:6380,redis://localhost:6381
# 如果使用单节点Redis，可以设置为：
# REDIS_CLUSTER_NODES=redis://localhost:6379

REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=100

# ============================================================================
# PostgreSQL配置 - 标注数据存储
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=realcrawl
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# ============================================================================
# S3/OSS配置 - HTML内容存储
# ============================================================================
S3_BUCKET=realcrawl-html
S3_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
# 如果使用MinIO等自建S3服务，设置endpoint
S3_ENDPOINT_URL=

# ============================================================================
# 缓存配置
# ============================================================================
CACHE_TTL=3600
CACHE_MAX_SIZE=10000

# ============================================================================
# 限流配置
# ============================================================================
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT=1000

# ============================================================================
# 监控配置
# ============================================================================
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================================================
# 前端配置
# ============================================================================
FRONTEND_URL=http://localhost:3000
# CORS允许的源，用逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================================
# 数据压缩配置
# ============================================================================
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6

# ============================================================================
# 分页配置
# ============================================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================================================
# 文件上传配置
# ============================================================================
# 最大文件大小（字节）
MAX_FILE_SIZE=10485760
# 允许的文件类型，用逗号分隔
ALLOWED_FILE_TYPES=html,htm

# ============================================================================
# 环境特定配置示例
# ============================================================================

# 开发环境示例：
# DEBUG=true
# POSTGRES_HOST=localhost
# REDIS_CLUSTER_NODES=redis://localhost:6379
# S3_ENDPOINT_URL=http://localhost:9000

# 生产环境示例：
# DEBUG=false
# SECRET_KEY=your-production-secret-key-64-chars-long-random-string
# POSTGRES_HOST=your-production-db-host
# POSTGRES_PASSWORD=your-production-db-password
# REDIS_CLUSTER_NODES=redis://redis-node1:6379,redis://redis-node2:6379,redis://redis-node3:6379
# S3_ACCESS_KEY=your-production-s3-access-key
# S3_SECRET_KEY=your-production-s3-secret-key

# 测试环境示例：
# DEBUG=true
# POSTGRES_DB=realcrawl_test
# REDIS_DB=1
# S3_BUCKET=realcrawl-test-html 